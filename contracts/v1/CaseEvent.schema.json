{
  "$id": "urn:p06:v1:CaseEvent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Case Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "event_type": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Event Type",
      "type": "string"
    },
    "id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Id",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    }
  },
  "required": [
    "id",
    "case_id",
    "event_type",
    "payload",
    "created_at"
  ],
  "title": "CaseEvent",
  "type": "object"
}
