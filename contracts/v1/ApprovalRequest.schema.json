{
  "$id": "urn:p06:v1:ApprovalRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": [
        "approve",
        "reject"
      ],
      "title": "Decision",
      "type": "string"
    },
    "plan_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Hash",
      "type": "string"
    }
  },
  "required": [
    "plan_hash",
    "decision"
  ],
  "title": "ApprovalRequest",
  "type": "object"
}
